{
  "name": "react-minimal-terminal",
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "description": "A lightweight, modern animated terminal window for React",
  "author": "Manuel Damian",
  "homepage": "https://github.com/ManuelDamian/react-minimal-terminal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManuelDamian/react-minimal-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/ManuelDamian/react-minimal-terminal/issues"
  },
  "keywords": [
    "react",
    "terminal",
    "animated",
    "typewriter",
    "component",
    "ui"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.1"
  }
}
