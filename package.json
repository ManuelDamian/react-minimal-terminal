{
  "name": "react-minimal-terminal",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "A lightweight, modern animated terminal window for React",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
